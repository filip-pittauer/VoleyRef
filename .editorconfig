# Jednotný formát souborů pro všechny editory (VS Code: rozšíření „EditorConfig for VS Code“).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# v Markdownu jsou dvě mezery na konci řádku zalomení
[*.md]
trim_trailing_whitespace = false
